# Local-only settings for Genresi. Copy this file to .env and fill in values.
# Never commit .env or real credentials.

# Odoo database manager password and administrator password.
ODOO_ADMIN_PASSWD=replace-with-a-strong-local-password

# PostgreSQL connection used by the project scripts.
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=postgres
PGPASSWORD=

# Optional local paths. Keep ODOO_ROOT pointing at the existing Odoo source;
# the source is referenced in place and must not be copied into this repository.
ODOO_ROOT=D:\odoo\Odoo17
