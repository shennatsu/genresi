<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_genresi" model="ir.module.category">
        <field name="name">Genresi</field>
        <field name="description">Hak akses aplikasi Genresi.</field>
        <field name="sequence">30</field>
    </record>

    <record id="group_genresi_viewer" model="res.groups">
        <field name="name">Viewer</field>
        <field name="category_id" ref="module_category_genresi"/>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]"/>
    </record>

    <record id="group_genresi_staf" model="res.groups">
        <field name="name">Staf</field>
        <field name="category_id" ref="module_category_genresi"/>
        <field name="implied_ids" eval="[Command.link(ref('group_genresi_viewer'))]"/>
    </record>

    <record id="group_genresi_owner" model="res.groups">
        <field name="name">Owner</field>
        <field name="category_id" ref="module_category_genresi"/>
        <field name="implied_ids" eval="[Command.link(ref('group_genresi_staf'))]"/>
    </record>
</odoo>
