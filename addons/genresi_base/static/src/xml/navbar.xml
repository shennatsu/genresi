<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="genresi_base.NavBar" t-inherit="web.NavBar" t-inherit-mode="extension">
        <xpath expr="//DropdownItem[contains(@class, 'o_menu_brand')]" position="before">
            <img class="genresi-navbar-logo"
                src="/genresi_base/static/src/img/genresi_icon.png"
                alt="Genresi"/>
        </xpath>
    </t>
</templates>
