<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_recipe_list" model="ir.ui.view">
        <field name="name">genresi.recipe.list</field>
        <field name="model">genresi.recipe</field>
        <field name="arch" type="xml">
            <tree string="Resep">
                <field name="name"/>
                <field name="recipe_type"/>
                <field name="batch_output_qty"/>
                <field name="cost_per_piece" widget="monetary"/>
                <field name="has_incomplete_cost" widget="boolean"/>
                <field name="state" widget="badge"/>
            </tree>
        </field>
    </record>
    <record id="view_recipe_form" model="ir.ui.view">
        <field name="name">genresi.recipe.form</field>
        <field name="model">genresi.recipe</field>
        <field name="arch" type="xml">
            <form string="Resep">
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="draft,active,archived"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_products" type="object" class="oe_stat_button" icon="fa-cubes">
                            <field name="product_count" widget="statinfo" string="Produk"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Harga belum lengkap" bg_color="text-bg-warning"
                        invisible="not has_incomplete_cost"/>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="recipe_type"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="batch_output_qty"/>
                            <field name="additional_cost" widget="monetary"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <group string="Ringkasan Biaya">
                        <field name="total_cost" widget="monetary" readonly="1"/>
                        <field name="cost_per_piece" widget="monetary" readonly="1"/>
                        <field name="has_incomplete_cost" readonly="1"/>
                    </group>
                    <notebook>
                        <page string="Bahan Resep">
                            <field name="line_ids">
                                <tree editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="material_id"/>
                                    <field name="quantity"/>
                                    <field name="uom_id" readonly="1"/>
                                    <field name="unit_price" widget="monetary" readonly="1"/>
                                    <field name="subtotal" widget="monetary" readonly="1"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_recipe_search" model="ir.ui.view">
        <field name="name">genresi.recipe.search</field>
        <field name="model">genresi.recipe</field>
        <field name="arch" type="xml">
            <search string="Resep">
                <field name="name"/>
                <field name="recipe_type"/>
                <filter name="incomplete" string="Harga Belum Lengkap" domain="[('has_incomplete_cost', '=', True)]"/>
                <filter name="active" string="Aktif" domain="[('active', '=', True)]"/>
            </search>
        </field>
    </record>
    <record id="action_recipe" model="ir.actions.act_window">
        <field name="name">Resep</field>
        <field name="res_model">genresi.recipe</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_recipe_search"/>
    </record>
    <menuitem id="menu_recipe" name="Resep"
        parent="genresi_base.genresi_menu_stock" action="action_recipe"
        groups="genresi_base.group_genresi_viewer" sequence="30"/>
</odoo>
