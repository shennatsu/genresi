<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_production_list" model="ir.ui.view">
        <field name="name">genresi.production.list</field>
        <field name="model">genresi.production</field>
        <field name="arch" type="xml">
            <tree string="Produksi Harian">
                <field name="name"/>
                <field name="date"/>
                <field name="product_id"/>
                <field name="quantity"/>
                <field name="uom_id"/>
                <field name="state" widget="badge"/>
                <field name="warning"/>
            </tree>
        </field>
    </record>
    <record id="view_production_form" model="ir.ui.view">
        <field name="name">genresi.production.form</field>
        <field name="model">genresi.production</field>
        <field name="arch" type="xml">
            <form string="Produksi Harian">
                <header>
                    <button name="action_confirm" string="Konfirmasi Produksi" type="object"
                        class="btn-primary" invisible="state != 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Referensi"/>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <div class="alert alert-warning" role="alert" invisible="not warning">
                        <field name="warning" readonly="1"/>
                    </div>
                    <group>
                        <field name="date"/>
                        <field name="product_id"/>
                        <field name="quantity"/>
                        <field name="uom_id" readonly="1"/>
                    </group>
                    <notebook>
                        <page string="Bahan Terpakai">
                            <field name="move_ids" readonly="1">
                                <tree>
                                    <field name="material_id"/>
                                    <field name="quantity"/>
                                    <field name="uom_id"/>
                                    <field name="reference"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="view_production_search" model="ir.ui.view">
        <field name="name">genresi.production.search</field>
        <field name="model">genresi.production</field>
        <field name="arch" type="xml">
            <search string="Produksi Harian">
                <field name="name"/>
                <field name="product_id"/>
                <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="done" string="Selesai" domain="[('state', '=', 'done')]"/>
            </search>
        </field>
    </record>
    <record id="action_production" model="ir.actions.act_window">
        <field name="name">Produksi Harian</field>
        <field name="res_model">genresi.production</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_production_search"/>
    </record>
    <menuitem id="menu_production" name="Produksi Harian"
        parent="genresi_base.genresi_menu_stock" action="action_production"
        groups="genresi_base.group_genresi_viewer" sequence="45"/>
</odoo>
